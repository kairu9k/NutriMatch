SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# Daily.co
DAILY_CO_API_KEY=
DAILY_CO_BASE_URL=https://api.daily.co/v1

# USDA FoodData Central
USDA_FDC_API_KEY=

# Gmail SMTP (password reset emails). GMAIL_HOST_PASSWORD must be a Gmail
# App Password (Google Account > Security > 2-Step Verification > App
# Passwords), not the account login password. Blank = emails print to the
# console instead of sending, for local dev.
GMAIL_HOST_USER=
GMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Auth endpoint rate limits (DRF ScopedRateThrottle, per-IP for anonymous
# requests). Defaults shown are what's applied when these are left blank.
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REGISTER_RATE=5/min
THROTTLE_PASSWORD_RESET_REQUEST_RATE=5/min
THROTTLE_PASSWORD_RESET_CONFIRM_RATE=10/min
