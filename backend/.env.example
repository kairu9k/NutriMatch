SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production only (Render): the frontend's https address(es), comma-separated.
CSRF_TRUSTED_ORIGINS=

# Database: blank = local SQLite (backend/db.sqlite3). Production uses Neon
# Postgres, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# USDA FoodData Central
USDA_FDC_API_KEY=
# ^ free key: https://fdc.nal.usda.gov/api-key-signup (food search falls back to "not set up" when blank)

# Cloudinary — PRC license photos (RND registration), profile photos and
# Resource Library files. Free tier, no card required:
# https://cloudinary.com/users/register/free — cloud name, API key and API
# secret are on the dashboard. Blank = those uploads fail with a clear
# "Cloudinary is not configured" error (everything else still works, and
# the seeded demo accounts don't need it).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (email verification codes, password reset emails, notices).
# GMAIL_HOST_PASSWORD must be a Gmail App Password (Google Account >
# Security > 2-Step Verification > App Passwords), not the account login
# password. Blank = emails print to the console instead of sending, for
# local dev.
GMAIL_HOST_USER=
GMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Where links inside emails point (sign in, apply again).
FRONTEND_URL=http://localhost:3000
# Fallback support address (Admin > System Settings > Support email wins).
SUPPORT_EMAIL=nutrimatch36@gmail.com

# Auth endpoint rate limits (DRF ScopedRateThrottle, per-IP for anonymous
# requests). Defaults shown are what's applied when these are left blank.
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REGISTER_RATE=5/min
THROTTLE_VERIFY_EMAIL_RATE=10/min
THROTTLE_RESEND_VERIFICATION_RATE=5/min
THROTTLE_PASSWORD_RESET_REQUEST_RATE=5/min
THROTTLE_PASSWORD_RESET_CONFIRM_RATE=10/min

# Redis for live chat/notifications. Optional: blank = Channels' in-memory
# layer, enough for one server process (local dev and Render's free plan).
# Only needed when running several server processes.
REDIS_URL=

# SMS reminders (https://semaphore.co) — blank = SMS off
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
